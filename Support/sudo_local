# Installed at /etc/pam.d/sudo_local (444, root:wheel), create-if-absent only.
# The module lives at /usr/local/lib/pam/pam_serberus.so and MUST be referenced
# by absolute path: libpam searches more than one directory for a bare module
# name, so a bare name would not pin which file sudo loads.
