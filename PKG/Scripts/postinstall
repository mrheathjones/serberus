log_info() {
    "${LOGGER}" -t "${LOG_LABEL}" -p user.info "[INFO] $*"
}

log_warn() {
    "${LOGGER}" -t "${LOG_LABEL}" -p user.warning "[WARN] $*"
}

log_error() {
    "${LOGGER}" -t "${LOG_LABEL}" -p user.err "[ERROR] $*"
}

require_root() {
    if [[ "$("${ID}" -u)" -ne 0 ]]
    then
        log_error "Must run as root"
        exit 1
    fi
}

# Serberus rewires THIS Mac's sudo and AuthorizationDB, so installing onto
# another volume would either do nothing useful or touch the wrong system.
require_boot_volume() {
    if [[ "${TARGET_VOLUME}" != "/" ]]
    then
        log_error "Target volume is '${TARGET_VOLUME}', not '/'. Serberus must be installed on the running system."
        exit 1
    fi
}

