set -euo pipefail
umask 022

# System directories only: /usr/local/bin can be user-writable.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

# Absolute tool paths: this runs as root, so nothing is resolved via PATH.
readonly BASENAME="/usr/bin/basename"
readonly CAT="/bin/cat"
readonly CHMOD="/bin/chmod"
readonly CHOWN="/usr/sbin/chown"
readonly CODESIGN="/usr/bin/codesign"
readonly DATE="/bin/date"
readonly DIRNAME="/usr/bin/dirname"
readonly FILE="/usr/bin/file"
readonly ID="/usr/bin/id"
readonly KILLALL="/usr/bin/killall"
readonly LAUNCHCTL="/bin/launchctl"
readonly LOGGER="/usr/bin/logger"
readonly MKDIR="/bin/mkdir"
readonly PLUTIL="/usr/bin/plutil"
readonly RM="/bin/rm"
readonly STAT="/usr/bin/stat"
readonly UNAME="/usr/bin/uname"
readonly PLIST_BUDDY="/usr/libexec/PlistBuddy"

readonly ORG_PLIST_DOMAIN="com.herojoneslabs.serberus"
readonly SCRIPT_NAME=$("${BASENAME}" "$0")
readonly SCRIPT_DIR=$(cd "$("${DIRNAME}" "$0")" && pwd)
readonly SCRIPT_VERSION="1.8"
readonly LOG_LABEL="${ORG_PLIST_DOMAIN}.postinstall"
readonly TIMESTAMP=$("${DATE}" -u +%Y-%m-%dT%H:%M:%SZ)

##################################
### End Core Defined Variables ###
##################################

########################################
######## User Defined Variables ########
### Place your script variables here ###
########################################

readonly DAEMON_LABEL="com.herojoneslabs.serberus.daemon"
# The daemon ships as an app-like bundle so it can carry the provisioning profile
# that authorizes the Endpoint Security entitlement (see docs/esf-provisioning-and-notarization.md).
readonly DAEMON_BUNDLE="/Library/PrivilegedHelperTools/serberusd.app"
readonly DAEMON_BINARY="${DAEMON_BUNDLE}/Contents/MacOS/com.herojoneslabs.serberus.daemon"
# The authorization plugin identity-scoped authURI rules compose into rights
# ("SerberusAuth:identity"). Frozen name: deployed rights reference it.
readonly AUTH_PLUGIN="/Library/Security/SecurityAgentPlugins/SerberusAuth.bundle"
# The serberus CLI (payload). `serberus status` is part of the "daemon up" check.
readonly CLI_BINARY="/usr/local/bin/serberus"
# Seconds to wait after bootstrap for the daemon to have a running pid (the
# 8 s same-pid stability window, pam-lib SERBERUS_LAUNCHD_STABLE_SECONDS, is
# added on top).
readonly DAEMON_START_TIMEOUT=10
# Hard deadline for each daemon one-shot (--demote-jit, --restore-authdb).
readonly ONESHOT_TIMEOUT=120
# /usr/lib/pam is on the SEALED read-only system snapshot (macOS 11+); the
# module lives under the /usr/local firmlink and sudo_local references it by
# absolute path (pam-lib.sh SERBERUS_PAM_MODULE_PATH — keep in sync).
readonly PAM_MODULE_DIR="/usr/local/lib/pam"
readonly PAM_MODULE="${PAM_MODULE_DIR}/pam_serberus.so"
readonly LAUNCHD_PLIST="/Library/LaunchDaemons/com.herojoneslabs.serberus.daemon.plist"
readonly SUDO_LOCAL="/etc/pam.d/sudo_local"
readonly PAM_SUDO="/etc/pam.d/sudo"
readonly SUPPORT_DIR="/Library/Application Support/Serberus"
readonly STATE_PLIST="${SUPPORT_DIR}/state.plist"
readonly VERSION_PLIST="${SUPPORT_DIR}/version.plist"
readonly AUTHDB_BACKUPS="${SUPPORT_DIR}/authdb-backups"
# Installed by the payload so an admin can tear Serberus down later.
readonly INSTALLED_UNINSTALL="${SUPPORT_DIR}/uninstall.sh"
readonly INSTALLED_PAM_LIB="${SUPPORT_DIR}/pam-lib.sh"
# The product version: build-pkg.sh stages the repository's VERSION file
# beside this script. It is informational (version.plist), so a missing or
# malformed file is recorded as "unknown" rather than failing the install.
readonly VERSION_FILE="${SCRIPT_DIR}/VERSION"
PRODUCT_VERSION=""
if [[ -f "${VERSION_FILE}" && ! -L "${VERSION_FILE}" ]]
then
    IFS= read -r PRODUCT_VERSION < "${VERSION_FILE}" || true
fi
if [[ ! "${PRODUCT_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
then
    PRODUCT_VERSION="unknown"
fi
readonly PRODUCT_VERSION
# Whether this build has the Endpoint Security exec gate: build-pkg.sh stages
# EXEC_GATE (enabled | disabled; disabled for an ESF=off build). Recorded in
# version.plist as execGate; "unknown" when missing or malformed.
readonly EXEC_GATE_FILE="${SCRIPT_DIR}/EXEC_GATE"
EXEC_GATE=""
if [[ -f "${EXEC_GATE_FILE}" && ! -L "${EXEC_GATE_FILE}" ]]
then
    IFS= read -r EXEC_GATE < "${EXEC_GATE_FILE}" || true
fi
if [[ "${EXEC_GATE}" != "enabled" && "${EXEC_GATE}" != "disabled" ]]
then
    EXEC_GATE="unknown"
fi
readonly EXEC_GATE
readonly DAEMON_VERSION="${PRODUCT_VERSION}"
readonly PAM_VERSION="${PRODUCT_VERSION}"
readonly CLI_VERSION="${PRODUCT_VERSION}"

# Installer passes the target volume as $3. Serberus gates THIS system's sudo
# and AuthorizationDB, so it only installs onto the running system.
readonly TARGET_VOLUME="${3:-}"

# Staged next to this script by build-pkg.sh stage_scripts(): the shared
# sudo_local merge/preflight logic and the canonical from-scratch content.
readonly PAM_LIB_PATH="${SCRIPT_DIR}/pam-lib.sh"
readonly SUDO_LOCAL_TEMPLATE="${SCRIPT_DIR}/sudo_local"

# Success marker: set right before the final exit 0. The EXIT trap runs the
# abort path whenever the script ends without it.
INSTALL_SUCCEEDED=0
# Set while abort_install runs, so the EXIT trap never re-enters it.
ABORT_IN_PROGRESS=0
# Daemon trust, from assess_daemon_trust (read-only). Until it has run — and
# whenever the daemon fails signature validation — the abort path does NOT
# execute the daemon binary.
DAEMON_TRUSTED=0
DAEMON_TEAM=""
# Set to 0 when the booted-out daemon is still loaded after its ExitTimeOut;
# the abort path then skips the one-shots and logs the manual steps.
DAEMON_GONE=1
# Epoch seconds taken right before `launchctl bootstrap`; only a state.plist
# the new daemon wrote after it counts.
BOOTSTRAP_MARK=""
# Degraded reason upgrade_validation_passes reports (pam_not_wired unless
# only the authorization plugin failed).
VALIDATION_REASON="pam_not_wired"

